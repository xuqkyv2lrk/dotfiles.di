#!/usr/bin/env bash
# SketchyBar config — Catppuccin Mocha, mirrors noctalia/niri aesthetic

CONFIG_DIR="${HOME}/.config/sketchybar"
export CONFIG_DIR

source "${CONFIG_DIR}/colors.sh"
source "${CONFIG_DIR}/icons.sh"

# ── Bar ──────────────────────────────────────────────────────────────────────

sketchybar --bar \
    height=36 \
    color="${BAR_COLOR}" \
    border_width=0 \
    shadow=off \
    position=top \
    sticky=on \
    padding_right=10 \
    padding_left=10

# ── Defaults ─────────────────────────────────────────────────────────────────

sketchybar --default \
    updates=when_shown \
    icon.font="JetBrainsMono Nerd Font:Regular:14.0" \
    icon.color="${ICON_COLOR}" \
    label.font="JetBrainsMono Nerd Font:Regular:12.0" \
    label.color="${LABEL_COLOR}" \
    padding_left=4 \
    padding_right=4

# ── Items ─────────────────────────────────────────────────────────────────────
# Left: workspace indicators

source "${CONFIG_DIR}/items/spaces.sh"

# Right: system status (right-to-left order)

source "${CONFIG_DIR}/items/clock.sh"
source "${CONFIG_DIR}/items/battery.sh"
source "${CONFIG_DIR}/items/wifi.sh"

# ── Initial workspace state ──────────────────────────────────────────────────

FOCUSED="$(aerospace list-workspaces --focused 2>/dev/null || echo '1')"
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="${FOCUSED}"

sketchybar --update
