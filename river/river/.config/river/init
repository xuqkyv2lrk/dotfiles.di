#!/usr/bin/env bash
set -euo pipefail

mod="Super"

# Export Wayland environment into systemd and D-Bus so portals and services
# that start after graphical-session.target can connect to the display
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# ---- Input ----
riverctl keyboard-layout us
riverctl set-repeat 25 600

# ---- Applications ----
riverctl map normal "$mod" Return spawn foot
riverctl map normal "$mod" O      spawn firefox
riverctl map normal "$mod" E      spawn nautilus
riverctl map normal "$mod" D      spawn "noctalia msg panel-toggle launcher"
riverctl map normal "$mod" P      spawn "noctalia msg panel-toggle session"

# ---- Session ----
riverctl map normal "$mod"       L spawn "noctalia msg session lock"
riverctl map normal "$mod"       M exit

# ---- Window management ----
riverctl map normal "$mod"       Q close
riverctl map normal "$mod+Shift" F toggle-fullscreen
riverctl map normal "$mod"       V toggle-float
riverctl map normal "$mod"       Z zoom

# ---- Focus ----
riverctl map normal "$mod" Left  focus-view left
riverctl map normal "$mod" Right focus-view right
riverctl map normal "$mod" Up    focus-view up
riverctl map normal "$mod" Down  focus-view down

# ---- Move windows ----
riverctl map normal "$mod+Shift" Left  swap left
riverctl map normal "$mod+Shift" Right swap right
riverctl map normal "$mod+Shift" Up    swap up
riverctl map normal "$mod+Shift" Down  swap down

# ---- Layout (rivertile) ----
riverctl map normal "$mod+Alt" Left  send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal "$mod+Alt" Right send-layout-cmd rivertile "main-ratio +0.05"
riverctl map normal "$mod+Alt" Up    send-layout-cmd rivertile "main-count +1"
riverctl map normal "$mod+Alt" Down  send-layout-cmd rivertile "main-count -1"

# ---- Tags 1-9 (Super+N to focus, Super+Shift+N to move window) ----
for i in $(seq 1 9); do
    tags=$((1 << (i - 1)))
    riverctl map normal "$mod"         "$i" set-focused-tags    $tags
    riverctl map normal "$mod+Shift"   "$i" set-view-tags       $tags
    riverctl map normal "$mod+Control" "$i" toggle-focused-tags $tags
done

# ---- Mouse ----
riverctl map-pointer normal "$mod" BTN_LEFT   move-view
riverctl map-pointer normal "$mod" BTN_RIGHT  resize-view
riverctl map-pointer normal "$mod" BTN_MIDDLE toggle-float

# ---- Noctalia IPC ----
riverctl map normal "$mod+Shift"   N spawn "noctalia msg panel-toggle control-center notifications"
riverctl map normal "$mod+Shift"   M spawn "noctalia msg media toggle"
riverctl map normal "$mod+Shift"   S spawn "noctalia msg settings-toggle"
riverctl map normal "$mod+Shift"   C spawn "noctalia msg panel-toggle control-center"
riverctl map normal "$mod+Shift"   T spawn "noctalia msg bar-toggle"
riverctl map normal "$mod+Shift"   I spawn "noctalia msg caffeine-toggle"
riverctl map normal "$mod+Control" V spawn "noctalia msg panel-toggle clipboard"

# ---- Media and brightness (work on lock screen too) ----
for mode in normal locked; do
    riverctl map "$mode" None XF86AudioRaiseVolume  spawn "noctalia msg volume-up 5"
    riverctl map "$mode" None XF86AudioLowerVolume  spawn "noctalia msg volume-down 5"
    riverctl map "$mode" None XF86AudioMute         spawn "noctalia msg volume-mute"
    riverctl map "$mode" None XF86AudioMicMute      spawn "noctalia msg mic-mute"
    riverctl map "$mode" None XF86AudioPlay         spawn "noctalia msg media toggle"
    riverctl map "$mode" None XF86AudioPrev         spawn "noctalia msg media previous"
    riverctl map "$mode" None XF86AudioNext         spawn "noctalia msg media next"
    riverctl map "$mode" None XF86MonBrightnessUp   spawn "noctalia msg brightness-up"
    riverctl map "$mode" None XF86MonBrightnessDown spawn "noctalia msg brightness-down"
done

# ---- Screenshots ----
riverctl map normal None        Print spawn "noctalia msg screenshot-region"
riverctl map normal Shift       Print spawn "noctalia msg screenshot-annotate"
riverctl map normal Control     Print spawn "record-region"

# ---- Appearance ----
riverctl background-color 0x1e1e2e
riverctl border-color-focused   0xcba6f7
riverctl border-color-unfocused 0x585b70
riverctl border-color-urgent    0xf38ba8
riverctl border-width 2

# Force server-side decorations so River draws borders on all windows
riverctl rule-add -app-id '*' ssd

# ---- Float rules (csd overrides global ssd — no border on floating windows) ----
riverctl rule-add -app-id "org.gnome.Nautilus"      float
riverctl rule-add -app-id "org.gnome.Nautilus"      csd
riverctl rule-add -app-id "com.saivert.pwvucontrol" float
riverctl rule-add -app-id "com.saivert.pwvucontrol" csd
riverctl rule-add -app-id "lxqt-policykit-agent"    float
riverctl rule-add -app-id "lxqt-policykit-agent"    csd
riverctl rule-add -app-id "Plexamp"                 float
riverctl rule-add -app-id "Plexamp"                 csd

# ---- Layout ----
riverctl default-layout rivertile
rivertile -view-padding 2 -outer-padding 2 &

# ---- Autostart ----
kanshi &
noctalia &
